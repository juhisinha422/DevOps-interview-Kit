# 1. Create Physical Volume (PV)
pvcreate /dev/sdb

# 2. Create Volume Group (VG)
vgcreate my_vg /dev/sdb

# 3. Create Logical Volume (LV)
lvcreate -L 10G -n my_lv my_vg

# 4. Format the Logical Volume
mkfs.ext4 /dev/my_vg/my_lv

# 5. Mount the LV
mkdir /mnt/mydata
mount /dev/my_vg/my_lv /mnt/mydata

# 6. Extend Logical Volume (and resize filesystem)
lvextend -L +5G /dev/my_vg/my_lv
resize2fs /dev/my_vg/my_lv

# Create a snapshot (for backups or testing)
lvcreate -L 1G -s -n my_snapshot /dev/my_vg/my_lv

# Remove logical volume
lvremove /dev/my_vg/my_lv
