create file then next
    
🔹 Step 4: Add Sample Java Code (With Issues 😄)
📁 src/main/java/com/demo/App.java

package com.demo;

public class App {

    public static void main(String[] args) {
        App app = new App();
        app.divide(10, 0); // BUG: Division by zero
    }

    public int divide(int a, int b) {
        return a / b;
    }

    public void unusedMethod() {
        System.out.println("I am never used"); // Code smell
    }
}
🔹 Step 5: Add Test Case
📁 src/test/java/com/demo/AppTest.java

package com.demo;

import org.junit.Test;
import static org.junit.Assert.*;

public class AppTest {

    @Test
    public void testDivide() {
        App app = new App();
        assertEquals(5, app.divide(10, 2));
    }
}
🔹 Step 6: Generate SonarQube Token
Go to SonarQube UI
My Account → Security
Generate token
Copy it
